################################################################################
# General
################################################################################

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.out

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Editor specific
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

################################################################################
# Node.js / JavaScript / TypeScript
################################################################################

# Node modules
node_modules/
.npm

# pnpm
.pnp.*

# TypeScript / JavaScript build output
# This will catch the root /dist directory and its contents
/dist/

# Test runner caches and reports
.cache
.nyc_output/
coverage/
.vitest.*

################################################################################
# Application Specific
################################################################################

# Local Databases
*.db
*.sqlite
*.sqlite3

# Generated code directory
/generated/

# Local cline rules configuration
.clinerules-*

################################################################################
# Tree-sitter Grammar specific (within src/grammars/)
################################################################################
# These are often generated by 'tree-sitter generate'

# Generated C parser
/src/grammars/src/parser.c
# Generated C header for the grammar
/src/grammars/bindings/c/tree_sitter/tree-sitter-extended-sql.h
# Generated Node.js binding files
/src/grammars/bindings/node/binding.cc
/src/grammars/bindings/node/index.js
# Native Node module compiled output
/src/grammars/bindings/node/*.node
/src/grammars/bindings/node/build/
/src/grammars/bindings/node/prebuilds/


# Build artifacts from src/grammars (if you build wasm, native modules, etc. there)
/src/grammars/build/
/src/grammars/target/ # For Rust
/src/grammars/*.wasm
/src/grammars/lib/    # Often a target for compiled libraries

# Python specific build artifacts if building python bindings within src/grammars
/src/grammars/bindings/python/build/
/src/grammars/bindings/python/*.egg-info/
/src/grammars/bindings/python/**/*.so
/src/grammars/bindings/python/**/*.pyd

################################################################################
# Python (General, might be more relevant if examples are more complex or if Python is used at root)
################################################################################

__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/          # Python specific build dir, be careful if you have a global build/
develop-eggs/
dist/           # Python specific dist dir, /dist/ above covers the main one
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtualenv
.venv/
venv/
ENV/
env/
# Note: examples/python has its own .gitignore which likely handles these for the example

################################################################################
# Go (General, for binaries. examples/go has its own .gitignore)
################################################################################

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Editor/IDE specific for Go
.vscode-go/ # For VSCode Go extension

# If examples/go/main is a compiled binary (not a directory)
# examples/go/main

# Add other common ignores as your project grows
# For example, environment files:
# .env
# .env.*
# !.env.example
