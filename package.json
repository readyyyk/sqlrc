{
  "name": "sqlrc-gen",
  "version": "0.1.0",
  "description": "Generate type-safe database code from SQL files with SQLRC extensions",
  "main": "dist/cli.js",
  "bin": {
    "sqlrc-gen": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "grammar:generate": "cd src/grammars && tree-sitter generate",
    "grammar:build": "cd src/grammars && tree-sitter build --wasm",
    "prepare": "npm run build"
  },
  "keywords": [
    "sql",
    "code-generation",
    "typescript",
    "go",
    "python",
    "database"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.18",
    "tree-sitter-cli": "^0.25.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "tree-sitter": "^0.22.4",
    "web-tree-sitter": "^0.25.4"
  }
}
